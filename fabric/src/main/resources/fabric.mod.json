{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "${mod_icon}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "grill24.potionsplus.core.fabric.PotionsPlusFabric"
    ],
    "client": [
      "grill24.potionsplus.core.fabric.PotionsPlusFabricClient"
    ],
    "jei_mod_plugin": [
      "grill24.potionsplus.client.integration.jei.JeiPotionsPlusPlugin"
    ]
  },
  "accessWidener": "potionsplus.accesswidener",
  "mixins": [
    "potionsplus.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "${mod_fabric_minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*"
  }
}

# Done to increase the memory available to Gradle.
org.gradle.jvmargs=-Xmx2G
org.gradle.parallel=true

# Mod properties
mod_version = 1.6.10
mod_description = More potions. Better brewing. Most fun.
mod_id = potionsplus
mod_name = Potions Plus
mod_authors = grill24
mod_license = MIT
mod_icon = icon.png
mod_neoforge_version_range = [${neoforge_version},)
mod_minecraft_version_range = [${minecraft_version},)
mod_fabric_minecraft_version = ~${minecraft_version}
maven_group = grill24.potionsplus
archives_name = potionsplus
# Fabric NOT enabled yet — add "fabric," when ready
enabled_platforms = fabric,neoforge

# Minecraft properties
minecraft_version = 26.1.2

# Dependencies
fabric_loader_version = 0.19.1
fabric_api_version = 0.145.4+26.1.2
neoforge_version = 26.1.2.4-beta

# Mod compat — versions are PLACEHOLDERS, must be verified before runtime (Chunk 5)
# JEI:         https://maven.blamejared.com/mezz/jei/
# GlitchCore:  https://github.com/glitchfiend/GlitchCore-Feedback/releases
# TerraBlender: https://github.com/glitchfiend/TerraBlender/releases
jei_version = PLACEHOLDER
glitchcore_version = PLACEHOLDER
terrablender_version = PLACEHOLDER
